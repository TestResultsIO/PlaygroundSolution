<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- the package assemblies must be in the output folder: to run from VS with the engine host, and for the containers (which exclude what the engine and environment model provide) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="**\*.g.cs">
      <DependentUpon>$([System.String]::Copy("%(Filename)").Replace(".g", "")).cs</DependentUpon>
    </Compile>
    <None Update="**\*.g.json">
      <DependentUpon>$([System.String]::Copy("%(Filename)").Replace(".g", "")).cs</DependentUpon>
    </None>
    <None Update="**\*.user.json">
      <DependentUpon>$([System.String]::Copy("%(Filename)").Replace(".user", "")).json</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="Images\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\**\Screen_Image.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup>
    <CoreCompileDependsOn>$(CoreCompileDependsOn);GeneratedImageClasses</CoreCompileDependsOn>
  </PropertyGroup>
  <Target Name="GeneratedImageClasses">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratedClasses\**\*.struct.cs" />
    </ItemGroup>
  </Target>
</Project>